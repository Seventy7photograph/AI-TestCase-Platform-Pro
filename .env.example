# ==================== 应用配置 ====================
APP_NAME=AI-TestCase-Platform-Pro
APP_VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO

# ==================== 存储配置 ====================
# 相对路径基于项目根目录；也可写绝对路径
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=20

# ==================== LLM 配置 ====================
# 可选值: deepseek | openai_compatible | fake
#   - deepseek           : 调用 DeepSeek 官方 API（需填写 LLM_API_KEY）
#   - openai_compatible  : 调用任意 OpenAI 兼容端点（需填写 LLM_BASE_URL + LLM_API_KEY）
#   - fake               : 离线假实现，仅用于测试/演示，不产生真实智能输出
# 未填写 LLM_API_KEY 时系统自动降级为纯规则引擎（功能可跑通，不使用大模型）
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ==================== 设计引擎配置 ====================
# 单条需求最多生成的用例数（防止边界值爆炸）
MAX_CASES_PER_REQUIREMENT=60